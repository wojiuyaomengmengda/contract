    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-vue": "^9.17.0",
    "lodash-es": "^4.17.21",
    "npm-run-all": "^4.1.5",
    "pnpm": "^8.13.1",
    "postcss": "^8.5.1",
