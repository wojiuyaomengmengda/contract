{
  "name": "csmart-public-business",
  "version": "0.0.14",
  "private": false,
  "type": "module",
  "keywords": [
    "csmart-public-business"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js build",
    "build-only:px2rem": "vite build --config=vite.config.px2rem.ts",
    "build-only:all": "run-p build-only build-only:px2rem",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@amcharts/amcharts4": "^4.10.36",
    "crypto-js": "^4.2.0",
    "mitt": "^3.0.0",
    "nprogress": "^0.2.0",
    "pinia": "^2.1.7",
    "pinia-plugin-persist": "^1.0.0",
    "pinia-plugin-persistedstate": "^4.2.0"
  },
  "files": [
    "lib",
    "lib-px2rem/style.css",
    "Readme.md",
    "package.json",
    "LICENSE"
  ],
  "main": "lib/csmart-public-business.umd.cjs",
  "module": "lib/csmart-public-business.js",
  "types": "lib/packages/index.d.ts",
  "engines": {
    "node": ">=16.0.0"
  },
  "peerDependencies": {
    "@arco-design/web-vue": "^2.54.1",
    "axios": "^1.6.3",
    "dayjs": "^1.11.10",
